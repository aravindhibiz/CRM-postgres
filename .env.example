# ==============================================
# BACKEND ENVIRONMENT VARIABLES
# Copy to backend/.env and fill in your values
# ==============================================

# Database Configuration
# Local development: postgresql://postgres:password@localhost:5432/crm_db
# Heroku: Use Heroku Postgres DATABASE_URL (automatically provided)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/crm_db

# JWT Configuration
# IMPORTANT: Generate a strong random secret key for production!
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-generate-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth Configuration
# Get these from Google Cloud Console -> APIs & Services -> Credentials
# IMPORTANT: Update authorized redirect URIs for production domain!
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Microsoft SSO Configuration
# Get these from Azure Portal -> App Registrations
# IMPORTANT: Configure redirect URI in Azure: http://localhost:8000/api/v1/auth/microsoft/callback
# For production, update: https://your-backend-domain.com/api/v1/auth/microsoft/callback
MICROSOFT_CLIENT_ID=your-microsoft-client-id-here
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret-here
MICROSOFT_TENANT_ID=your-tenant-id-here
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/your-tenant-id-here
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
MICROSOFT_SCOPES=openid email profile User.Read

# Frontend URL (for CORS and OAuth redirects)
# Local: http://localhost:3000
# Production: https://your-app-name.herokuapp.com or your custom domain
FRONTEND_URL=http://localhost:3000

# Integration Encryption Key (generate a secure 32-byte key)
INTEGRATION_ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Email Configuration (SMTP - Outlook/Office365)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
FROM_EMAIL=your-email@example.com

# Legacy SendGrid Configuration (deprecated - use SMTP instead)
# SENDGRID_API_KEY=SG.your-sendgrid-api-key-here



# Azure Blob Storage Configuration
# Get these from Azure Portal -> Storage Accounts
# RECOMMENDED: Use Azure Blob Storage for production (Heroku's filesystem is ephemeral)
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_STORAGE_ACCOUNT_KEY=your-storage-account-key
AZURE_STORAGE_CONNECTION_STRING=your-connection-string
AZURE_BLOB_CONTAINER_NAME=crm-files

# Storage Configuration
# Options: 'local', 'azure_blob'
# Local: Use for development only
# Production: Use 'azure_blob' (Heroku's filesystem doesn't persist across deployments)
STORAGE_BACKEND=local

# ==============================================
# FRONTEND ENVIRONMENT VARIABLES
# Copy to frontend/.env and fill in your values
# ==============================================

# Backend API URL
# Local: http://localhost:8000/
# Production: https://your-backend-app.herokuapp.com/ or your custom domain
# NOTE: Include trailing slash
VITE_API_URL=http://localhost:8000/

# Gemini AI Configuration
# Get your API key from https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here