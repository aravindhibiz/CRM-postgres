# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost/crm_db

# JWT Configuration
SECRET_KEY=your-secret-key-here

# Google OAuth Configuration
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Frontend URL (adjust if using different port)
FRONTEND_URL=http://localhost:3001

# Integration Encryption Key (generate a secure 32-byte key)
INTEGRATION_ENCRYPTION_KEY=your-32-byte-encryption-key-here