# ==============================================
# BACKEND ENVIRONMENT VARIABLES
# Copy to backend/.env and fill in your values
# ==============================================

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/crm_db

# JWT Configuration
SECRET_KEY=your-secret-key-here-generate-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth Configuration
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Integration Encryption Key (generate a secure 32-byte key)
INTEGRATION_ENCRYPTION_KEY=your-32-byte-encryption-key-here

# SendGrid Configuration
# Get your API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=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

# ==============================================
# FRONTEND ENVIRONMENT VARIABLES
# Copy to frontend/.env and fill in your values
# ==============================================

# Backend API URL
VITE_API_URL=http://localhost:8000/

# Gemini AI Configuration
# Get your API key from https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here